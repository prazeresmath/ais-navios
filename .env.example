# Copie para .env e preencha. O .env NUNCA vai para o git.

# API key gratuita do aisstream.io (https://aisstream.io)
AISSTREAM_API_KEY=

# Usuário e senha do ClickHouse local (escolha os seus)
CLICKHOUSE_USER=ais
CLICKHOUSE_PASSWORD=

# Recorte geográfico: lat_min,lon_min,lat_max,lon_max
# Padrão: Porto de Santos + fundeadouro
AIS_BBOX=-24.20,-46.50,-23.85,-46.05
